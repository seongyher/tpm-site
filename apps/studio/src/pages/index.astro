---
import { StudioWorkspace } from "../components/react/StudioWorkspace";
import StudioLayout from "../layouts/StudioLayout.astro";

const studioOperationId = "studio-gui-mvp-fixture";
const initialScreenStateId = Astro.url.searchParams.get("screen") ?? undefined;
---

<StudioLayout
  title="TPM Studio"
  description="Fixture-backed shell for the TPM Studio GUI MVP."
>
  <main class="bg-background text-foreground min-h-screen" id="studio">
    <StudioWorkspace
      client:load
      initialScreenStateId={initialScreenStateId}
      operationId={studioOperationId}
    />
  </main>
</StudioLayout>
