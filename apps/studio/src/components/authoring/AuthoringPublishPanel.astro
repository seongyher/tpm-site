---
import type { StudioAuthoringPayload } from "../../data/authoring-operation";

interface Props {
  publish: StudioAuthoringPayload["publish"];
  release: StudioAuthoringPayload["release"];
}

const { publish, release } = Astro.props;
const releaseWarnings = release.health.warnings;
---

<section
  class="border-border bg-panel-muted rounded-md border p-4"
  id="publish"
  aria-labelledby="publish-heading"
>
  <h3 id="publish-heading" class="text-lg font-bold tracking-normal">
    Release and publish
  </h3>
  <p class="mt-2 leading-6">{release.health.summary}</p>
  {
    releaseWarnings.length > 0 && (
      <ul class="mt-3 grid gap-1">
        {releaseWarnings.map((warning) => (
          <li class="text-warning text-sm leading-6">{warning}</li>
        ))}
      </ul>
    )
  }
  <div class="mt-3 grid gap-2">
    {
      publish.providerActions.map((action) => (
        <article class="border-border bg-panel rounded-md border p-3">
          <h4 class="font-bold tracking-normal [overflow-wrap:anywhere]">
            {action.providerId}
          </h4>
          <p class="text-muted-foreground mt-1 text-sm [overflow-wrap:anywhere]">
            {action.operation}
            {" \u00b7 "}
            {action.behavior}
          </p>
        </article>
      ))
    }
  </div>
  <p class="text-muted-foreground mt-3 text-sm leading-6">
    {publish.requiredApproval}
  </p>
</section>
