---
import StatusBadge from "../StatusBadge.astro";
import {
  surfaceStatusLabel,
  surfaceStatusTone,
  type StudioAuthoringPayload,
} from "../../data/authoring-operation";

interface Props {
  verification: StudioAuthoringPayload["verification"];
}

const { verification } = Astro.props;
---

<section
  class="border-border bg-panel-muted mt-4 rounded-md border p-4"
  id="verification"
  aria-labelledby="verification-heading"
>
  <h3 id="verification-heading" class="text-lg font-bold tracking-normal">
    Verification
  </h3>
  <div class="mt-3 grid gap-2 md:grid-cols-2 xl:grid-cols-5">
    {
      verification.map((item) => (
        <article class="border-border bg-panel rounded-md border p-3">
          <div class="flex items-start justify-between gap-3">
            <h4 class="font-bold tracking-normal">{item.label}</h4>
            <StatusBadge
              label={surfaceStatusLabel(item.status)}
              tone={surfaceStatusTone(item.status)}
            />
          </div>
          <ul class="text-muted-foreground mt-2 grid gap-1 text-sm leading-6">
            {item.evidence.map((evidence) => (
              <li>{evidence}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
