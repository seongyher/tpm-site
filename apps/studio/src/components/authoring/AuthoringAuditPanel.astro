---
import {
  surfaceStatusLabel,
  type StudioAuthoringPayload,
} from "../../data/authoring-operation";

interface Props {
  credentials: StudioAuthoringPayload["credentials"];
  publish: StudioAuthoringPayload["publish"];
}

const { credentials, publish } = Astro.props;
const auditEvents = publish.auditEvents;
const rollback = publish.rollback;
---

<section
  class="border-border bg-panel-muted rounded-md border p-4"
  id="audit"
  aria-labelledby="audit-heading"
>
  <h3 id="audit-heading" class="text-lg font-bold tracking-normal">
    Credentials and audit
  </h3>
  <div class="mt-3 grid gap-2">
    {
      credentials.map((credential) => (
        <article class="border-border bg-panel rounded-md border p-3">
          <h4 class="font-bold tracking-normal">{credential.displayLabel}</h4>
          <p class="text-muted-foreground mt-1 text-sm [overflow-wrap:anywhere]">
            {credential.reference.providerId}
            {" \u00b7 "}
            {credential.reference.state}
            {" \u00b7 "}
            {credential.reference.storage}
          </p>
          <p class="text-muted-foreground mt-2 text-sm [overflow-wrap:anywhere]">
            {credential.reference.scopes.join(", ")}
            {" \u00b7 "}
            {credential.reference.secretReference}
          </p>
        </article>
      ))
    }
  </div>
  <article class="border-border bg-panel mt-3 rounded-md border p-3">
    <h4 class="font-bold tracking-normal">Rollback</h4>
    <p class="mt-2 leading-6">{rollback.summary}</p>
    <p class="text-muted-foreground mt-2 text-sm [overflow-wrap:anywhere]">
      {rollback.restoreTarget}
      {" \u00b7 "}
      {surfaceStatusLabel(rollback.status)}
    </p>
  </article>
  <div class="mt-3 grid gap-2">
    {
      auditEvents.map((event) => (
        <article class="border-border bg-panel rounded-md border p-3">
          <h4 class="font-bold tracking-normal [overflow-wrap:anywhere]">
            {event.operationId}
          </h4>
          <p class="text-muted-foreground mt-1 text-sm [overflow-wrap:anywhere]">
            {event.actor}
            {" \u00b7 "}
            {event.safetyClass}
            {" \u00b7 "}
            {event.dryRun ? "dry run" : "apply"}
          </p>
          <p class="mt-2 leading-6">{event.summary}</p>
        </article>
      ))
    }
  </div>
</section>
