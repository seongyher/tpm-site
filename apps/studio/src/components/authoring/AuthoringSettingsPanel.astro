---
import type { StudioAuthoringPayload } from "../../data/authoring-operation";

interface Props {
  settings: StudioAuthoringPayload["settings"];
}

const { settings } = Astro.props;
---

<section
  class="border-border bg-panel-muted rounded-md border p-4"
  id="settings"
  aria-labelledby="settings-heading"
>
  <h3 id="settings-heading" class="text-lg font-bold tracking-normal">
    Settings
  </h3>
  <div class="mt-3 grid gap-2">
    {
      settings.map((field) => (
        <article class="border-border bg-panel rounded-md border p-3">
          <div class="flex flex-wrap items-start justify-between gap-2">
            <div class="min-w-0">
              <h4 class="font-bold tracking-normal">{field.label}</h4>
              <p class="text-muted-foreground text-sm [overflow-wrap:anywhere]">
                {field.id}
                {" \u00b7 "}
                {field.inputKind}
                {" \u00b7 "}
                {field.visibility}
              </p>
            </div>
            <span class="text-muted-foreground text-sm font-bold">
              {field.required ? "Required" : "Optional"}
            </span>
          </div>
          <p class="mt-2 leading-6 [overflow-wrap:anywhere]">
            {field.value ?? "No value in fixture"}
          </p>
          <p class="text-muted-foreground mt-2 text-sm [overflow-wrap:anywhere]">
            {field.generatedEffects.join(", ")}
          </p>
        </article>
      ))
    }
  </div>
</section>
