---
import StatusBadge from "../StatusBadge.astro";
import {
  surfaceStatusLabel,
  surfaceStatusTone,
  type StudioAuthoringPayload,
} from "../../data/authoring-operation";

interface Props {
  surfaces: StudioAuthoringPayload["surfaces"];
}

const { surfaces } = Astro.props;
---

<div class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
  {
    surfaces.map((surface) => (
      <article class="border-border bg-panel-muted grid gap-3 rounded-md border p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h3 class="text-base leading-snug font-bold tracking-normal">
              {surface.label}
            </h3>
            <p class="text-muted-foreground mt-1 text-sm [overflow-wrap:anywhere]">
              {surface.operationId}
            </p>
          </div>
          <StatusBadge
            label={surfaceStatusLabel(surface.status)}
            tone={surfaceStatusTone(surface.status)}
          />
        </div>
        <p class="leading-6">{surface.summary}</p>
        <ul class="grid gap-1">
          {surface.requiredCapabilities.map((capability) => (
            <li class="text-muted-foreground text-sm [overflow-wrap:anywhere]">
              {capability.providerId}: {capability.operation}
              {" \u00b7 "}
              {capability.status}
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
