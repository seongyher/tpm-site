---
import type { StudioAuthoringPayload } from "../../data/authoring-operation";

interface Props {
  media: StudioAuthoringPayload["media"];
}

const { media } = Astro.props;
---

<section
  class="border-border bg-panel-muted rounded-md border p-4"
  id="media"
  aria-labelledby="media-heading"
>
  <h3 id="media-heading" class="text-lg font-bold tracking-normal">Media</h3>
  <p class="text-muted-foreground mt-2 leading-6">
    {media.entries.length} entries
    {" \u00b7 "}
    {media.materializationPlan.mode}
  </p>
  <ul class="mt-3 grid gap-1">
    {
      media.materializationPlan.steps.map((step) => (
        <li class="text-sm leading-6">{step}</li>
      ))
    }
  </ul>
</section>
