---
import {
  surfaceStatusLabel,
  type StudioAuthoringPayload,
} from "../../data/authoring-operation";

interface Props {
  content: StudioAuthoringPayload["content"];
}

const { content } = Astro.props;
const editorDocument = content.editorDocument;
---

<section
  class="border-border bg-panel-muted rounded-md border p-4"
  id="content"
  aria-labelledby="content-heading"
>
  <h3 id="content-heading" class="text-lg font-bold tracking-normal">
    Content
  </h3>
  <div class="mt-3 grid gap-2">
    {
      content.entries.map((entry) => (
        <article class="border-border bg-panel rounded-md border p-3">
          <h4 class="font-bold tracking-normal">{entry.title}</h4>
          <p class="text-muted-foreground mt-1 text-sm [overflow-wrap:anywhere]">
            {entry.source.displayPath}
          </p>
          <p class="text-muted-foreground mt-2 text-sm">
            {entry.format}
            {" \u00b7 "}
            {entry.lineCount} lines
            {" \u00b7 "}
            {entry.byteCount} bytes
          </p>
        </article>
      ))
    }
  </div>
  {
    editorDocument && (
      <article class="border-border bg-panel mt-3 rounded-md border p-3">
        <h4 class="font-bold tracking-normal">Source view</h4>
        <p class="text-muted-foreground mt-1 text-sm [overflow-wrap:anywhere]">
          {editorDocument.source.displayPath}
        </p>
        <p class="mt-2 leading-6">{editorDocument.sourceFidelity}</p>
        <p class="text-muted-foreground mt-2 text-sm">
          {content.draftPlan.label}:{" "}
          {surfaceStatusLabel(content.draftPlan.mode)}
        </p>
      </article>
    )
  }
</section>
