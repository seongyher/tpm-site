---
import type { SocialPreviewImage } from "../../lib/social-images";
import { routeMetadataGraphViewModel } from "../../lib/metadata-graph";
import { type JsonLdNode, type RouteMetadata } from "../../lib/metadata";

interface Props {
  image?: SocialPreviewImage | undefined;
  metadata: RouteMetadata;
  structuredData?: readonly (JsonLdNode | undefined)[] | undefined;
  type?: "website" | "article";
  webPageMainEntity?: JsonLdNode | undefined;
}

const {
  image,
  metadata,
  structuredData = [],
  type = "website",
  webPageMainEntity,
} = Astro.props;
const head = routeMetadataGraphViewModel({
  image,
  metadata,
  site: Astro.site,
  structuredData,
  type,
  webPageMainEntity,
});
---

<meta name="description" content={head.description} />
<meta name="robots" content={head.robots} />
<meta name="application-name" content={head.applicationName} />
<meta name="color-scheme" content="light dark" />
{head.themeColor && <meta name="theme-color" content={head.themeColor} />}
<link rel="canonical" href={head.canonicalUrl} />
{
  head.feedAlternate && (
    <link
      rel={head.feedAlternate.rel}
      type={head.feedAlternate.type}
      title={head.feedAlternate.title}
      href={head.feedAlternate.href}
    />
  )
}
<meta property="og:site_name" content={head.openGraph.siteName} />
<meta property="og:locale" content={head.openGraph.locale} />
<meta property="og:type" content={head.openGraph.type} />
<meta property="og:title" content={head.openGraph.title} />
<meta property="og:description" content={head.openGraph.description} />
<meta property="og:url" content={head.openGraph.url} />
{
  head.openGraph.image && (
    <meta property="og:image" content={head.openGraph.image.url} />
  )
}
{
  head.openGraph.image && (
    <meta
      property="og:image:width"
      content={head.openGraph.image.width.toString()}
    />
  )
}
{
  head.openGraph.image && (
    <meta
      property="og:image:height"
      content={head.openGraph.image.height.toString()}
    />
  )
}
{
  head.openGraph.image && (
    <meta property="og:image:type" content={head.openGraph.image.type} />
  )
}
{
  head.openGraph.image?.alt && (
    <meta property="og:image:alt" content={head.openGraph.image.alt} />
  )
}
<meta name="twitter:card" content={head.twitter.card} />
{head.twitter.site && <meta name="twitter:site" content={head.twitter.site} />}
<meta name="twitter:title" content={head.twitter.title} />
<meta name="twitter:description" content={head.twitter.description} />
{
  head.twitter.image && (
    <meta name="twitter:image" content={head.twitter.image} />
  )
}
{
  head.twitter.imageAlt && (
    <meta name="twitter:image:alt" content={head.twitter.imageAlt} />
  )
}
<title>{head.title}</title>
{
  head.jsonLd && (
    <script is:inline type="application/ld+json" set:html={head.jsonLd} />
  )
}
