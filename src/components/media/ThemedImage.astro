---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import { isImageMetadata } from "../../lib/content-images";

type ThemedImageSource = ImageMetadata | string;

interface Props {
  alt: string;
  class?: string;
  darkImage: ThemedImageSource;
  fetchpriority?: "auto" | "high" | "low";
  layout?: "constrained" | "fixed" | "full-width";
  lightImage: ThemedImageSource;
  loading?: "eager" | "lazy";
  priorityVariant?: "both" | "dark" | "light";
  sizes?: string;
}

const {
  alt,
  class: className,
  darkImage,
  fetchpriority,
  layout = "constrained",
  lightImage,
  loading,
  priorityVariant = "light",
  sizes,
} = Astro.props;

const lightIsPriority =
  priorityVariant === "light" || priorityVariant === "both";
const darkIsPriority = priorityVariant === "dark" || priorityVariant === "both";
const loadingFor = (isPriority: boolean) =>
  isPriority || loading !== "eager" ? loading : "lazy";
const fetchPriorityFor = (isPriority: boolean) =>
  isPriority || fetchpriority !== "high" ? fetchpriority : "low";
const lightLoading = loadingFor(lightIsPriority);
const darkLoading = loadingFor(darkIsPriority);
const lightFetchPriority = fetchPriorityFor(lightIsPriority);
const darkFetchPriority = fetchPriorityFor(darkIsPriority);
---

{
  isImageMetadata(lightImage) ? (
    <Image
      src={lightImage}
      alt={alt}
      layout={layout}
      loading={lightLoading}
      fetchpriority={lightFetchPriority}
      sizes={sizes}
      class:list={["block dark:hidden", className]}
    />
  ) : (
    <img
      src={lightImage}
      alt={alt}
      loading={lightLoading}
      fetchpriority={lightFetchPriority}
      sizes={sizes}
      class:list={["block dark:hidden", className]}
    />
  )
}
{
  isImageMetadata(darkImage) ? (
    <Image
      src={darkImage}
      alt={alt}
      layout={layout}
      loading={darkLoading}
      fetchpriority={darkFetchPriority}
      sizes={sizes}
      class:list={["hidden dark:block", className]}
    />
  ) : (
    <img
      src={darkImage}
      alt={alt}
      loading={darkLoading}
      fetchpriority={darkFetchPriority}
      sizes={sizes}
      class:list={["hidden dark:block", className]}
    />
  )
}
