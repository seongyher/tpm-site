---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

import { publishableMediaFallbackPolicy } from "../../lib/media-policy";

type PrefetchValue = "hover" | "load" | "tap" | "viewport" | boolean;

interface PublishableImage {
  alt: string;
  src: ImageMetadata;
}

interface Props extends HTMLAttributes<"a"> {
  fallbackLabel?: string | undefined;
  href: string;
  image?: PublishableImage | undefined;
  imageClass?: string | undefined;
  imageWidths?: number[] | undefined;
  label: string;
  fetchpriority?: "auto" | "high" | "low" | undefined;
  loading?: "eager" | "lazy" | undefined;
  prefetch?: PrefetchValue | undefined;
  quality?: "low" | "mid" | "high" | "max" | number | undefined;
  renderHeight: number;
  renderWidth: number;
  sizes?: string | undefined;
}

const {
  fallbackLabel,
  href,
  image,
  imageClass = "h-full w-full object-cover",
  imageWidths,
  label,
  fetchpriority,
  loading = "lazy",
  prefetch,
  quality,
  renderHeight,
  renderWidth,
  sizes,
  class: className,
  "aria-label": ariaLabel,
  ...attrs
} = Astro.props;
const prefetchAttrs =
  prefetch === undefined ? {} : { "data-astro-prefetch": prefetch };
const imageRenderAttrs = {
  ...(imageWidths === undefined ? {} : { widths: imageWidths }),
  ...(sizes === undefined ? {} : { sizes }),
  ...(quality === undefined ? {} : { quality }),
  ...(fetchpriority === undefined ? {} : { fetchpriority }),
};
const fallback = publishableMediaFallbackPolicy({
  fallbackLabel,
  label,
  surface: "listing-html",
}).fallback;
---

<a
  {...attrs}
  {...prefetchAttrs}
  href={href}
  aria-label={ariaLabel ?? label}
  class:list={[
    "block min-w-0 overflow-hidden rounded-xs no-underline",
    className,
  ]}
  data-publishable-media-frame
  data-publishable-media-has-image={image === undefined ? "false" : "true"}
>
  {
    image ? (
      <Image
        src={image.src}
        alt={image.alt}
        width={renderWidth}
        height={renderHeight}
        {...imageRenderAttrs}
        loading={loading}
        data-publishable-media-image="true"
        class:list={[imageClass]}
      />
    ) : (
      <span
        class="flex h-full w-full items-center justify-center p-4 text-center text-4xl leading-none font-bold tracking-normal uppercase"
        data-publishable-media-fallback
        aria-hidden={
          fallback.kind === "text" && fallback.ariaHidden ? "true" : undefined
        }
      >
        <span class="line-clamp-2 break-words">{fallback.label}</span>
      </span>
    )
  }
</a>
