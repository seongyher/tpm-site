---
import { Maximize2, Search } from "lucide-astro";

import AuthorArticleList from "../components/authors/AuthorArticleList.astro";
import AuthorBioBlock from "../components/authors/AuthorBioBlock.astro";
import AuthorByline from "../components/authors/AuthorByline.astro";
import AuthorLink from "../components/authors/AuthorLink.astro";
import AuthorPage from "../components/authors/AuthorPage.astro";
import AuthorProfileHeader from "../components/authors/AuthorProfileHeader.astro";
import AuthorSocialLinks from "../components/authors/AuthorSocialLinks.astro";
import AuthorsIndexPage from "../components/authors/AuthorsIndexPage.astro";
import BibliographyEmptyState from "../components/bibliography/BibliographyEmptyState.astro";
import BibliographyEntry from "../components/bibliography/BibliographyEntry.astro";
import BibliographyList from "../components/bibliography/BibliographyList.astro";
import BibliographyPage from "../components/bibliography/BibliographyPage.astro";
import BibliographySourceArticles from "../components/bibliography/BibliographySourceArticles.astro";
import ArticleCard from "../components/articles/ArticleCard.astro";
import ArticleBibliography from "../components/articles/ArticleBibliography.astro";
import ArticleCitationMenu from "../components/articles/ArticleCitationMenu.astro";
import ArticleEndcap from "../components/articles/ArticleEndcap.astro";
import ArticleFootnotes from "../components/articles/ArticleFootnotes.astro";
import ArticleHeader from "../components/articles/ArticleHeader.astro";
import ArticleShareMenu from "../components/articles/ArticleShareMenu.astro";
import HoverImageCard from "../components/articles/HoverImageCard.astro";
import ArticleImage from "../components/articles/ArticleImage.astro";
import ArticleList from "../components/articles/ArticleList.astro";
import ArticleMeta from "../components/articles/ArticleMeta.astro";
import ArticleProse from "../components/articles/ArticleProse.astro";
import ArticleReferenceBacklinks from "../components/articles/ArticleReferenceBacklinks.astro";
import ArticleReferences from "../components/articles/ArticleReferences.astro";
import ArticleTableOfContents from "../components/articles/ArticleTableOfContents.astro";
import ArticleTags from "../components/articles/ArticleTags.astro";
import ArchiveListBlock from "../components/blocks/ArchiveListBlock.astro";
import CategoryOverviewBlock from "../components/blocks/CategoryOverviewBlock.astro";
import CategoryRailBlock from "../components/blocks/CategoryRailBlock.astro";
import HomeAnnouncementBlock from "../components/blocks/HomeAnnouncementBlock.astro";
import HomeArchiveLinksBlock from "../components/blocks/HomeArchiveLinksBlock.astro";
import HomeCategoryOverviewBlock from "../components/blocks/HomeCategoryOverviewBlock.astro";
import HomeFeaturedArticlesBlock from "../components/blocks/HomeFeaturedArticlesBlock.astro";
import HomeHeroBlock from "../components/blocks/HomeHeroBlock.astro";
import HomeLatestArticleBlock from "../components/blocks/HomeLatestArticleBlock.astro";
import MoreInCategoryBlock from "../components/articles/MoreInCategoryBlock.astro";
import NextArticleBlock from "../components/articles/NextArticleBlock.astro";
import RelatedArticlesBlock from "../components/articles/RelatedArticlesBlock.astro";
import SearchResultsBlock from "../components/blocks/SearchResultsBlock.astro";
import SupportBlock from "../components/blocks/SupportBlock.astro";
import MainFrame from "../components/layout/MainFrame.astro";
import PageFrame from "../components/layout/PageFrame.astro";
import PriorityInlineRow from "../components/layout/PriorityInlineRow.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import EmbedFrame from "../components/media/EmbedFrame.astro";
import ResponsiveIframe from "../components/media/ResponsiveIframe.astro";
import SoundCloudEmbed from "../components/media/SoundCloudEmbed.astro";
import ThemedImage from "../components/media/ThemedImage.astro";
import YouTubeEmbed from "../components/media/YouTubeEmbed.astro";
import BrandLink from "../components/navigation/BrandLink.astro";
import CategoryGroup from "../components/navigation/CategoryGroup.astro";
import CategoryTree from "../components/navigation/CategoryTree.astro";
import MobileMenu from "../components/navigation/MobileMenu.astro";
import PrimaryNav from "../components/navigation/PrimaryNav.astro";
import SearchForm from "../components/navigation/SearchForm.astro";
import SearchReveal from "../components/navigation/SearchReveal.astro";
import SectionNav from "../components/navigation/SectionNav.astro";
import SectionNavItem from "../components/navigation/SectionNavItem.astro";
import SupportLink from "../components/navigation/SupportLink.astro";
import ThemeToggle from "../components/navigation/ThemeToggle.astro";
import MarkdownPage from "../components/pages/MarkdownPage.astro";
import PageHeader from "../components/pages/PageHeader.astro";
import PageProse from "../components/pages/PageProse.astro";
import ActionCluster from "../components/ui/ActionCluster.astro";
import Container from "../components/ui/Container.astro";
import IconButton from "../components/ui/IconButton.astro";
import LinkButton from "../components/ui/LinkButton.astro";
import TextLink from "../components/ui/TextLink.astro";
import articleLandscapeImage from "./assets/catalog-article-landscape.png";
import articleTallImage from "./assets/catalog-article-tall.png";
import sampleDarkImage from "./assets/catalog-sample-dark.svg";
import sampleImage from "./assets/catalog-sample-light.svg";
import { catalogMetadata } from "./catalog.config";
import CatalogExample from "./CatalogExample.astro";
import CatalogSection from "./CatalogSection.astro";
import {
  catalogArticleItems,
  catalogNavigationItems,
  catalogRtlArticleItems,
  catalogTags,
  longTranslatedActionLabel,
} from "./examples/hostile-fixtures";
import UiPrimitivesCatalogSection from "./sections/UiPrimitivesCatalogSection.astro";
import { getAuthorProfiles } from "../lib/authors";
import { articleImagePresentation } from "../lib/article-image-policy";
import type { BibliographyEntry as BibliographyEntryViewModel } from "../lib/bibliography";
import { primaryNavigationItems } from "../lib/navigation";

const catalogPublicationName = "Catalog Review Site";
const catalogAuthorName = "Catalog Fixture";
const catalogArticleSlug = "catalog-boundary-example";
const catalogArticleTitle =
  "A Catalog Article With a Long But Plausible Editorial Title";
const catalogArticleUrl = `https://example.com/articles/${catalogArticleSlug}/`;
const catalogSupportUrl = "https://example.com/support";
const catalogSupportActions = {
  discord: {
    ariaLabel: "Join the catalog Discord",
    href: "https://example.com/discord",
    label: "Join Discord",
  },
  enabled: true,
  patreon: {
    ariaLabel: "Support the catalog site on Patreon",
    href: catalogSupportUrl,
    label: "Support Us",
  },
} as const;
const catalogSupportBlock = {
  ...catalogSupportActions,
  body: "Support independent publishing and maintenance.",
  title: "Support The Catalog",
} as const;
const generatedImagePresentation = articleImagePresentation();
const catalogArticleCitation = {
  articleId: catalogArticleSlug,
  canonicalUrl: catalogArticleUrl,
  formats: [
    {
      id: "bibtex",
      label: "BibTeX",
      text: `@online{catalog-boundary-example,
  author = {${catalogAuthorName}},
  title = {${catalogArticleTitle}},
  year = {2026},
  date = {2026-01-12},
  organization = {${catalogPublicationName}},
  url = {${catalogArticleUrl}},
}`,
    },
    {
      id: "mla",
      label: "MLA",
      text: `${catalogAuthorName}. "${catalogArticleTitle}." ${catalogPublicationName}, 12 Jan. 2026, ${catalogArticleUrl}.`,
    },
  ],
  title: catalogArticleTitle,
} as const;

const catalogArticleShare = {
  actions: [
    {
      copyText: catalogArticleUrl,
      icon: "copy-link",
      id: "copy-link",
      kind: "copy",
      label: "Copy link",
    },
    {
      href: "mailto:?subject=A%20Catalog%20Article%20With%20a%20Long%20But%20Plausible%20Title",
      icon: "email",
      id: "email",
      kind: "email",
      label: "Email",
    },
    {
      href: "https://twitter.com/intent/tweet?text=A+Catalog+Article+With+a+Long+But+Plausible+Title&url=https%3A%2F%2Fexample.com%2Farticles%2Fcatalog-boundary-example%2F",
      icon: "x",
      id: "x",
      kind: "external",
      label: "X",
    },
  ],
  articleUrl: catalogArticleUrl,
  copyText: catalogArticleUrl,
  title: catalogArticleTitle,
} as const;

const catalogTocHeadings = [
  {
    depth: 2,
    href: "#first-major-heading",
    id: "first-major-heading",
    level: 1,
    order: 0,
    text: "First major heading",
  },
  {
    depth: 3,
    href: "#nested-heading-with-a-long-title-that-wraps-inside-the-rail",
    id: "nested-heading-with-a-long-title-that-wraps-inside-the-rail",
    level: 2,
    order: 1,
    text: "Nested heading with a long title that wraps inside the rail",
  },
  {
    depth: 2,
    href: "#duplicate-heading",
    id: "duplicate-heading",
    level: 1,
    order: 2,
    text: "Duplicate heading",
  },
  {
    depth: 2,
    href: "#duplicate-heading-1",
    id: "duplicate-heading-1",
    level: 1,
    order: 3,
    text: "Duplicate heading",
  },
] as const;
const anchoredPresetMatrix = [
  "header-dropdown",
  "header-search-start",
  "header-search-end",
  "mobile-shell-panel",
  "inline-hover-preview",
] as const;
const catalogArticleItemsWithMedia = [
  {
    ...catalogArticleItems[0],
    image: {
      alt: "Catalog sample preview image",
      src: sampleImage,
    },
  },
  catalogArticleItems[1],
  {
    ...catalogArticleItems[2],
    image: {
      alt: "Catalog dark-mode preview image",
      src: sampleDarkImage,
    },
  },
] as const;

const catalogBibliographyEntries = [
  {
    display: {
      authors: "Baudrillard, Jean",
      fallbackText:
        "Baudrillard, Jean. Simulacra and Simulation. Semiotext(e). 1981. Source.",
      publisher: "Semiotext(e)",
      sourceUrl: "https://example.com/source-with-a-very-long-path-that-wraps",
      title: "Simulacra and Simulation",
      year: "1981",
    },
    id: "bibliography-baudrillard-simulacra",
    sourceArticles: [
      {
        articleId: catalogArticleSlug,
        date: "January 12, 2026",
        href: `/articles/${catalogArticleSlug}/`,
        markerIds: ["cite-ref-baudrillard-1981"],
        publishedAt: new Date("2026-01-12T00:00:00.000Z"),
        title: catalogArticleTitle,
      },
      {
        articleId: "second-catalog-article",
        date: "May 16, 2021",
        href: "/articles/second-catalog-article/",
        markerIds: ["cite-ref-baudrillard-1981-2"],
        publishedAt: new Date("2021-05-16T00:00:00.000Z"),
        title: "Second Catalog Article",
      },
    ],
    sourceContent: [
      {
        children: [
          { kind: "text", text: "Baudrillard, Jean. " },
          {
            children: [{ kind: "text", text: "Simulacra and Simulation" }],
            kind: "emphasis",
            text: "Simulacra and Simulation",
          },
          { kind: "text", text: ". Semiotext(e). 1981. " },
          {
            children: [{ kind: "text", text: "Source" }],
            kind: "link",
            text: "Source",
            url: "https://example.com/source-with-a-very-long-path-that-wraps",
          },
          { kind: "text", text: "." },
        ],
        kind: "paragraph",
        text: "Baudrillard, Jean. Simulacra and Simulation. Semiotext(e). 1981. Source.",
      },
    ],
    sourceKey: "doi:catalog-baudrillard",
    sourceText:
      "Baudrillard, Jean. Simulacra and Simulation. Semiotext(e). 1981. Source.",
    sourceUrl: "https://example.com/source-with-a-very-long-path-that-wraps",
  },
  {
    display: {
      fallbackText:
        "Anonymous field report with no public URL and intentionally incomplete metadata.",
      title: "Anonymous field report",
    },
    id: "bibliography-anonymous-field-report",
    sourceArticles: [
      {
        articleId: "field-note-catalog-example",
        date: "April 4, 2022",
        href: "/articles/field-note-catalog-example/",
        markerIds: ["cite-ref-field-report"],
        publishedAt: new Date("2022-04-04T00:00:00.000Z"),
        title: "Field Note Catalog Example",
      },
    ],
    sourceContent: [
      {
        children: [
          {
            kind: "text",
            text: "Anonymous field report with no public URL and intentionally incomplete metadata.",
          },
        ],
        kind: "paragraph",
        text: "Anonymous field report with no public URL and intentionally incomplete metadata.",
      },
    ],
    sourceKey: "exact:anonymous-field-report",
    sourceText:
      "Anonymous field report with no public URL and intentionally incomplete metadata.",
  },
] as const satisfies readonly BibliographyEntryViewModel[];

const catalogReferences = {
  citations: [
    {
      bibtex: {
        entryType: "book",
        fields: {
          author: "Baudrillard, Jean",
          title: "Simulacra and Simulation",
          url: "https://example.com/source-with-a-very-long-path-that-wraps",
          year: "1981",
        },
        key: "baudrillard-1981",
        normalizedKey: "baudrillard-1981",
        raw: "@book{baudrillard-1981}",
      },
      definition: {
        children: [
          {
            children: [
              { kind: "text", text: "Baudrillard, Jean. " },
              {
                children: [{ kind: "text", text: "Simulacra and Simulation" }],
                kind: "emphasis",
                text: "Simulacra and Simulation",
              },
              { kind: "text", text: ". " },
              {
                children: [{ kind: "text", text: "Archive source" }],
                kind: "link",
                text: "Archive source",
                url: "https://example.com/source-with-a-very-long-path-that-wraps",
              },
              { kind: "text", text: ". " },
              { kind: "inlineCode", text: "1981" },
            ],
            kind: "paragraph",
            text: "Baudrillard, Jean. Simulacra and Simulation. Archive source. 1981",
          },
        ],
      },
      displayLabel: "Baudrillard 1981",
      id: "cite-baudrillard-1981",
      kind: "citation",
      label: "cite-baudrillard-1981",
      order: 1,
      references: [
        {
          backlinkId: "cite-backref-baudrillard-1981",
          displayText: "1",
          entryId: "cite-baudrillard-1981",
          id: "cite-ref-baudrillard-1981",
          kind: "citation",
          label: "cite-baudrillard-1981",
          order: 1,
        },
        {
          backlinkId: "cite-backref-baudrillard-1981-2",
          displayText: "1",
          entryId: "cite-baudrillard-1981",
          id: "cite-ref-baudrillard-1981-2",
          kind: "citation",
          label: "cite-baudrillard-1981",
          order: 2,
        },
      ],
    },
  ],
  notes: [
    {
      definition: {
        children: [
          {
            children: [
              { kind: "text", text: "A compact explanatory note with " },
              { kind: "inlineCode", text: "inline code" },
              { kind: "text", text: " and ordinary prose." },
            ],
            kind: "paragraph",
            text: "A compact explanatory note with inline code and ordinary prose.",
          },
        ],
      },
      id: "note-term-scope",
      kind: "note",
      label: "note-term-scope",
      order: 1,
      references: [
        {
          backlinkId: "note-backref-term-scope",
          displayText: "1",
          entryId: "note-term-scope",
          id: "note-ref-term-scope",
          kind: "note",
          label: "note-term-scope",
          order: 1,
        },
      ],
    },
  ],
} as const;
const realAuthorProfiles = await getAuthorProfiles();
const [realAuthorProfile] = realAuthorProfiles;

if (realAuthorProfile === undefined) {
  throw new Error(
    "The component catalog requires at least one author profile.",
  );
}

const catalogAuthorProfile = {
  ...realAuthorProfile,
  shortBio:
    "Catalog-only profile metadata demonstrates optional author biography surfaces.",
  socials: [
    {
      href: "https://example.com/author-profile",
      label: "Profile",
    },
  ],
  website: "https://example.com",
};
const catalogAuthorProfiles = [
  catalogAuthorProfile,
  ...realAuthorProfiles
    .filter((profile) => profile.id !== catalogAuthorProfile.id)
    .slice(0, 3),
];
const catalogAuthorSummaries = catalogAuthorProfiles
  .slice(0, 2)
  .map(({ displayName, href, id, shortBio, type }) => ({
    displayName,
    href,
    id,
    shortBio,
    type,
  }));
const [primaryCatalogAuthor] = catalogAuthorSummaries;

if (primaryCatalogAuthor === undefined) {
  throw new Error(
    "The component catalog requires at least one author summary.",
  );
}
---

<main class="bg-background text-foreground">
  <Container as="div" size="xl" class="grid gap-10 py-10">
    <header class="max-w-3xl">
      <p class="text-primary text-sm font-semibold uppercase">Design System</p>
      <h1 class="text-foreground mt-2 text-4xl font-bold tracking-normal">
        {catalogMetadata.title}
      </h1>
      <p class="text-muted-foreground mt-3 text-lg">
        {catalogMetadata.description}
      </p>
    </header>

    <UiPrimitivesCatalogSection
      catalogSupportUrl={catalogSupportUrl}
      anchoredPresetMatrix={anchoredPresetMatrix}
    />

    <CatalogSection
      title="Media Primitives"
      description="Embed components reserve stable space and require accessible metadata."
    >
      <CatalogExample
        title="ResponsiveIframe"
        description="Low-level responsive iframe frame."
        componentPath="src/components/media/ResponsiveIframe.astro"
      >
        <ResponsiveIframe src="about:blank" title="Blank catalog iframe" />
      </CatalogExample>

      <CatalogExample
        title="SoundCloudEmbed"
        description="Compact SoundCloud audio player wrapper."
        componentPath="src/components/media/SoundCloudEmbed.astro"
      >
        <SoundCloudEmbed
          sourceUrl="https://soundcloud.com/platform-blog/example-track"
          title="Catalog SoundCloud preview"
        />
      </CatalogExample>

      <CatalogExample
        title="YouTubeEmbed"
        description="Responsive YouTube video wrapper."
        componentPath="src/components/media/YouTubeEmbed.astro"
      >
        <YouTubeEmbed
          src="https://www.youtube.com/embed/example"
          title="Catalog YouTube preview"
        />
      </CatalogExample>

      <CatalogExample
        title="EmbedFrame"
        description="External embed wrapper with fallback source link."
        componentPath="src/components/media/EmbedFrame.astro"
      >
        <EmbedFrame
          title="External essay video"
          description="Fallback link remains available if the embed fails."
          fallbackHref="https://example.com/video"
        />
      </CatalogExample>

      <CatalogExample
        title="ThemedImage"
        description="Optimized image pair that switches artwork by light/dark theme."
        componentPath="src/components/media/ThemedImage.astro"
      >
        <div class="max-w-3xl">
          <ThemedImage
            lightImage={sampleImage}
            darkImage={sampleDarkImage}
            alt="Catalog sample art"
            layout="full-width"
            class="block h-auto w-full"
          />
        </div>
      </CatalogExample>
    </CatalogSection>

    <CatalogSection
      title="Article Components"
      description="Article surfaces, prose wrappers, discovery lists, and support prompts."
    >
      <CatalogExample
        title="ArticleHeader"
        description="Title block with category, metadata, citation utility, and description."
        componentPath="src/components/articles/ArticleHeader.astro"
      >
        <ArticleHeader
          author={catalogAuthorName}
          category={{ href: "/categories/research/", title: "Research" }}
          citation={catalogArticleCitation}
          date={new Date("2026-01-12T00:00:00.000Z")}
          description="A generic article header fixture exercises long titles, citations, share actions, and prose rhythm."
          formattedDate="January 12, 2026"
          share={catalogArticleShare}
          title={catalogArticleTitle}
        />
      </CatalogExample>

      <CatalogExample
        title="ArticleCitationMenu"
        description="Generated citation copy utility with visible no-JavaScript text."
        componentPath="src/components/articles/ArticleCitationMenu.astro"
      >
        <ArticleCitationMenu citation={catalogArticleCitation} />
      </CatalogExample>

      <CatalogExample
        title="ArticleShareMenu"
        description="Article share utility with copy, email, and social targets."
        componentPath="src/components/articles/ArticleShareMenu.astro"
      >
        <ArticleShareMenu share={catalogArticleShare} />
      </CatalogExample>

      <CatalogExample
        title="ArticleMeta"
        description="Author and machine-readable date metadata."
        componentPath="src/components/articles/ArticleMeta.astro"
      >
        <ArticleMeta
          author={catalogAuthorName}
          date={new Date("2026-01-12T00:00:00.000Z")}
          formattedDate="January 12, 2026"
        />
      </CatalogExample>

      <CatalogExample
        title="ArticleTags"
        description="Tag badges for article metadata."
        componentPath="src/components/articles/ArticleTags.astro"
      >
        <ArticleTags tags={catalogTags} />
      </CatalogExample>

      <CatalogExample
        title="ArticleImage - Default"
        description="Astro-optimized bounded image preview with a full-screen inspection action."
        componentPath="src/components/articles/ArticleImage.astro"
      >
        <ArticleImage
          src={articleTallImage}
          alt="A bounded article image preview"
          caption="Default bounded article image example."
        />
      </CatalogExample>

      <CatalogExample
        title="ArticleImage - Captioned"
        description="Default article image anatomy with caption, alt text, and optimized responsive sources."
        componentPath="src/components/articles/ArticleImage.astro"
      >
        <ArticleImage
          src={articleLandscapeImage}
          alt="Catalog sample preview image"
          caption="Article image caption example."
        />
      </CatalogExample>

      <CatalogExample
        title="ArticleImage - Long Alt"
        description="Long accessible image descriptions do not change the visual article image anatomy."
        componentPath="src/components/articles/ArticleImage.astro"
      >
        <ArticleImage
          src={articleLandscapeImage}
          alt="A deliberately long article image description used to verify that accessible image text remains available without becoming visible layout content in the article flow."
        />
      </CatalogExample>

      <CatalogExample
        title="ArticleImage - Natural"
        description="Natural height is the explicit escape hatch for intentional full-height component images."
        componentPath="src/components/articles/ArticleImage.astro"
      >
        <ArticleImage
          src={articleTallImage}
          alt="A full-height loss diagram"
          caption="Natural-height article image example."
          heightPolicy="natural"
        />
      </CatalogExample>

      <CatalogExample
        title="Generated Markdown Image - Unknown"
        description="Unknown-dimension generated Markdown images use the same bounded inspector contract without author components."
        componentPath="src/components/articles/ArticleProse.astro"
      >
        <ArticleProse enableImageInspector>
          <figure
            class:list={[generatedImagePresentation.figureClass]}
            data-article-image-figure="true"
            data-article-image-inspectable="true"
            data-article-image-policy="bounded"
          >
            <button
              type="button"
              class:list={[generatedImagePresentation.frameClass]}
              data-article-image-inspect-trigger="true"
              aria-haspopup="dialog"
              aria-label="View full image: Generated Markdown image"
            >
              <img
                src="/favicon.svg"
                alt="Generated Markdown illustration"
                class:list={[generatedImagePresentation.imageClass]}
                data-article-image="true"
                sizes={generatedImagePresentation.previewSizes}
              />
              <span
                class:list={[generatedImagePresentation.inspectionClass]}
                data-article-image-inspect-affordance="true"
                aria-hidden="true"
              >
                <Maximize2 class="size-3" aria-hidden="true" />
              </span>
            </button>
            <figcaption class:list={[generatedImagePresentation.captionClass]}>
              Generated Markdown image fallback example.
            </figcaption>
          </figure>
        </ArticleProse>
      </CatalogExample>

      <CatalogExample
        title="Generated Markdown Linked Image"
        description="Explicit image links keep their link behavior instead of becoming image inspector triggers."
        componentPath="src/components/articles/ArticleProse.astro"
      >
        <ArticleProse>
          <figure
            class:list={[generatedImagePresentation.figureClass]}
            data-article-image-figure="true"
            data-article-image-inspectable="false"
            data-article-image-policy="bounded"
          >
            <div class:list={[generatedImagePresentation.frameClass]}>
              <a
                href="/favicon.svg"
                class="focus-visible:outline-ring inline-flex max-w-full items-center justify-center rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2"
              >
                <img
                  src="/favicon.svg"
                  alt="Linked generated Markdown illustration"
                  class:list={[generatedImagePresentation.imageClass]}
                  data-article-image="true"
                  sizes={generatedImagePresentation.previewSizes}
                />
              </a>
            </div>
            <figcaption class:list={[generatedImagePresentation.captionClass]}>
              Linked Markdown image example.
            </figcaption>
          </figure>
        </ArticleProse>
      </CatalogExample>

      <CatalogExample
        title="HoverImageCard"
        description="Native anchored inline image-only preview for MDX article prose."
        componentPath="src/components/articles/HoverImageCard.astro"
      >
        <ArticleProse>
          <p>
            Hover or focus this
            <HoverImageCard
              image={sampleImage}
              label="inline preview"
              alt="Catalog sample preview image"
            />
            without leaving the paragraph flow.
          </p>
        </ArticleProse>
      </CatalogExample>

      <CatalogExample
        title="ArticleProse"
        description="Markdown body wrapper using Tailwind Typography."
        componentPath="src/components/articles/ArticleProse.astro"
      >
        <ArticleProse>
          <p>
            Article prose keeps generated Markdown readable without shipping a
            client-side renderer.
          </p>
          <h2>Subheading</h2>
          <p>
            Links, images, blockquotes, and code inherit the prose styling
            contract.
          </p>
        </ArticleProse>
      </CatalogExample>

      <CatalogExample
        title="ArticleTableOfContents"
        description="Article-local heading navigation for the reading margin rail."
        componentPath="src/components/articles/ArticleTableOfContents.astro"
      >
        <div class="max-w-64">
