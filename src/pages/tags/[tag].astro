---
import ArchiveListBlock from "../../components/blocks/listing/ArchiveListBlock.astro";
import BrowsingBody from "../../components/layout/BrowsingBody.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAuthorEntries } from "../../lib/content/authors";
import { getCategories, getTags } from "../../lib/content/content";
import { tagDetailRouteViewModel } from "../../lib/content/listing-route-view-models";
import {
  breadcrumbListJsonLd,
  itemListJsonLd,
} from "../../lib/metadata/metadata";
import { tagStaticPaths } from "../../lib/routes/static-paths";

/**
 * Generates one static tag route for each canonical public tag.
 *
 * @returns Static route parameters and tag props for Astro.
 */
export async function getStaticPaths() {
  return tagStaticPaths(await getTags());
}

const { tag } = Astro.props;
const model = tagDetailRouteViewModel({
  authors: await getAuthorEntries(),
  categories: await getCategories(),
  tag,
});
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
  structuredData={[
    breadcrumbListJsonLd(
      model.document.canonicalPath,
      model.breadcrumbs,
      Astro.site,
    ),
    itemListJsonLd(model.document.canonicalPath, model.items, Astro.site),
  ]}
>
  <BrowsingBody>
    <ArchiveListBlock
      eyebrow={model.eyebrow}
      title={model.listTitle}
      description={model.listDescription}
      items={model.items}
    />
  </BrowsingBody>
</BaseLayout>
