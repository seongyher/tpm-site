---
import { render } from "astro:content";

import BibliographyPage from "../components/bibliography/BibliographyPage.astro";
import BrowsingBody from "../components/layout/BrowsingBody.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { bibliographyRouteViewModel } from "../lib/content-route-view-models";
import { getArticles } from "../lib/content";
import { itemListJsonLd } from "../lib/metadata";
import { articleReferencesFromFrontmatter } from "../remark-plugins/articleReferences";

const articles = await getArticles();
const articleReferences = await Promise.all(
  articles.map(async (article) => {
    const { remarkPluginFrontmatter } = await render(article);

    return {
      article,
      references: articleReferencesFromFrontmatter(remarkPluginFrontmatter),
    };
  }),
);
const model = bibliographyRouteViewModel(articleReferences);
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
  structuredData={[
    itemListJsonLd(model.document.canonicalPath, model.items, Astro.site),
  ]}
>
  <BrowsingBody>
    <BibliographyPage entries={model.entries} />
  </BrowsingBody>
</BaseLayout>
