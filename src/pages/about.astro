---
import { getEntry, render } from "astro:content";

import ReadingBody from "../components/layout/ReadingBody.astro";
import MarkdownPage from "../components/pages/MarkdownPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { markdownPageRouteViewModel } from "../lib/content/content-route-view-models";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error("Missing about page content at site/content/pages/about.md.");
}

const { Content } = await render(about);
const model = markdownPageRouteViewModel(about, "about");
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
>
  <ReadingBody>
    <MarkdownPage title={model.title} description={model.description}>
      <Content />
    </MarkdownPage>
  </ReadingBody>
</BaseLayout>
