---
import ArchiveListBlock from "../../components/blocks/ArchiveListBlock.astro";
import BrowsingBody from "../../components/layout/BrowsingBody.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAuthorEntries } from "../../lib/authors";
import { getCategories } from "../../lib/content";
import { categoryDetailRouteViewModel } from "../../lib/listing-route-view-models";
import { breadcrumbListJsonLd, itemListJsonLd } from "../../lib/metadata";
import { categoryStaticPaths } from "../../lib/static-paths";

/**
 * Generates one static category route for each public category.
 *
 * @returns Static route parameters and category props for Astro.
 */
export async function getStaticPaths() {
  return categoryStaticPaths(await getCategories());
}

const { category } = Astro.props;
const model = categoryDetailRouteViewModel({
  authors: await getAuthorEntries(),
  category,
});
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
  structuredData={[
    breadcrumbListJsonLd(
      model.document.canonicalPath,
      model.breadcrumbs,
      Astro.site,
    ),
    itemListJsonLd(model.document.canonicalPath, model.items, Astro.site),
  ]}
>
  <BrowsingBody>
    <ArchiveListBlock
      eyebrow={model.eyebrow}
      title={model.listTitle}
      description={model.listDescription}
      items={model.items}
    />
  </BrowsingBody>
</BaseLayout>
