---
import CategoryOverviewBlock from "../../components/blocks/terms/CategoryOverviewBlock.astro";
import BrowsingBody from "../../components/layout/BrowsingBody.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategories } from "../../lib/content/content";
import { categoriesIndexRouteViewModel } from "../../lib/content/listing-route-view-models";
import { itemListJsonLd } from "../../lib/metadata/metadata";

const model = categoriesIndexRouteViewModel(await getCategories());
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
  structuredData={[
    itemListJsonLd(model.document.canonicalPath, model.items, Astro.site),
  ]}
>
  <BrowsingBody>
    <CategoryOverviewBlock
      title={model.overviewTitle}
      description={model.overviewDescription}
      items={model.items}
    />
  </BrowsingBody>
</BaseLayout>
