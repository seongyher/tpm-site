---
import SearchResultsBlock from "../components/blocks/SearchResultsBlock.astro";
import BrowsingBody from "../components/layout/BrowsingBody.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { searchRouteViewModel } from "../lib/listing-route-view-models";

const model = searchRouteViewModel();
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
>
  <BrowsingBody>
    <SearchResultsBlock />
  </BrowsingBody>
  <script src="../scripts/search-page.ts"></script>
</BaseLayout>
