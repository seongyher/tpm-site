---
import AuthorsIndexPage from "../../components/authors/AuthorsIndexPage.astro";
import BrowsingBody from "../../components/layout/BrowsingBody.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAuthorProfiles } from "../../lib/authors";
import { authorsIndexRouteViewModel } from "../../lib/listing-route-view-models";
import { itemListJsonLd } from "../../lib/metadata";

const model = authorsIndexRouteViewModel(await getAuthorProfiles());
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
  structuredData={[
    itemListJsonLd(
      model.document.canonicalPath,
      model.profileItems,
      Astro.site,
    ),
  ]}
>
  <BrowsingBody>
    <AuthorsIndexPage profiles={model.profiles} />
  </BrowsingBody>
</BaseLayout>
