---
import { render } from "astro:content";

import AuthorPage from "../../components/authors/AuthorPage.astro";
import BrowsingBody from "../../components/layout/BrowsingBody.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAuthorEntries, getAuthorProfiles } from "../../lib/authors";
import { getCategories } from "../../lib/content";
import { authorDetailRouteViewModel } from "../../lib/listing-route-view-models";
import {
  breadcrumbListJsonLd,
  itemListJsonLd,
  profileEntityJsonLd,
} from "../../lib/metadata";

/**
 * Generates one static author route for each public author profile.
 *
 * @returns Static route parameters and author-profile props for Astro.
 */
export async function getStaticPaths() {
  const profiles = await getAuthorProfiles();

  return profiles.map((profile) => ({
    params: { author: profile.id },
    props: { profile },
  }));
}

const { profile } = Astro.props;
const { Content } = await render(profile.entry);
const model = authorDetailRouteViewModel({
  authors: await getAuthorEntries(),
  categories: await getCategories(),
  profile,
});
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
  structuredData={[
    breadcrumbListJsonLd(
      model.document.canonicalPath,
      model.breadcrumbs,
      Astro.site,
    ),
    profileEntityJsonLd(model.profileEntity, Astro.site),
    itemListJsonLd(model.document.canonicalPath, model.items, Astro.site),
  ]}
>
  <BrowsingBody>
    <AuthorPage
      profile={model.profile}
      items={model.items}
      hasProfileBody={model.hasProfileBody}
    >
      <Content />
    </AuthorPage>
  </BrowsingBody>
</BaseLayout>
