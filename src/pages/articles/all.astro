---
import ArchiveListBlock from "../../components/blocks/ArchiveListBlock.astro";
import BrowsingBody from "../../components/layout/BrowsingBody.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAuthorEntries } from "../../lib/authors";
import { getArticles, getCategories } from "../../lib/content";
import { articlesArchiveRouteViewModel } from "../../lib/listing-route-view-models";
import { itemListJsonLd } from "../../lib/metadata";

const model = articlesArchiveRouteViewModel({
  articles: await getArticles(),
  authors: await getAuthorEntries(),
  categories: await getCategories(),
});
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
  structuredData={[
    itemListJsonLd(model.document.canonicalPath, model.items, Astro.site),
  ]}
>
  <BrowsingBody>
    <ArchiveListBlock
      title={model.listTitle}
      description={model.listDescription}
      items={model.items}
      pagefindIgnore
    />
  </BrowsingBody>
</BaseLayout>
