---
import ArchiveListBlock from "../../components/blocks/ArchiveListBlock.astro";
import CategoryRailBlock from "../../components/blocks/CategoryRailBlock.astro";
import BrowsingBody from "../../components/layout/BrowsingBody.astro";
import PageHeader from "../../components/pages/PageHeader.astro";
import LinkButton from "../../components/ui/LinkButton.astro";
import TextLink from "../../components/ui/TextLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAuthorEntries } from "../../lib/authors";
import { getArticles, getCategories } from "../../lib/content";
import { articlesIndexRouteViewModel } from "../../lib/listing-route-view-models";
import { itemListJsonLd } from "../../lib/metadata";
import { articlesIndexUrl } from "../../lib/routes";

const model = articlesIndexRouteViewModel({
  articles: await getArticles(),
  authors: await getAuthorEntries(),
  categories: await getCategories(),
});
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
  structuredData={[
    itemListJsonLd(articlesIndexUrl(), model.latestItems, Astro.site),
  ]}
>
  <BrowsingBody>
    <section class="grid gap-4">
      <PageHeader headingId="articles-heading" title="Articles">
        <Fragment slot="description">
          Browse articles by category, start with recent writing, or go straight
          to the <TextLink href={model.archiveHref} prefetch="hover"
            >complete article archive</TextLink
          >.
        </Fragment>
      </PageHeader>
      <div class="flex flex-wrap gap-3">
        <LinkButton
          href={model.archiveHref}
          variant="outline"
          tone="neutral"
          prefetch="hover"
        >
          View all articles
        </LinkButton>
      </div>
    </section>
    <CategoryRailBlock
      aria-label="Article categories"
      data-articles-category-rail
      items={model.categoryItems}
      railId="articles-categories-rail"
      title="Categories"
    />
    <ArchiveListBlock
      title={model.latestTitle}
      description="Recent writing from the archive."
      headingLevel={2}
      items={model.latestItems}
      pagefindIgnore
    />
  </BrowsingBody>
</BaseLayout>
