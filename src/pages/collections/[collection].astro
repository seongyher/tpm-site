---
import ArchiveListBlock from "../../components/blocks/listing/ArchiveListBlock.astro";
import BrowsingBody from "../../components/layout/BrowsingBody.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAuthorEntries } from "../../lib/content/authors";
import type { EditorialCollectionEntry } from "../../lib/content/collections";
import {
  getAnnouncements,
  getArticles,
  getCategories,
  getEditorialCollections,
} from "../../lib/content/content";
import { collectionDetailRouteViewModel } from "../../lib/content/listing-route-view-models";
import {
  breadcrumbListJsonLd,
  itemListJsonLd,
} from "../../lib/metadata/metadata";
import { collectionStaticPaths } from "../../lib/routes/static-paths";

/**
 * Generates one static collection route for each active editorial collection.
 *
 * @returns Static route parameters and collection props for Astro.
 */
export async function getStaticPaths() {
  return collectionStaticPaths(await getEditorialCollections());
}

interface Props {
  collection: EditorialCollectionEntry;
}

const { collection } = Astro.props;
const model = collectionDetailRouteViewModel({
  announcements: await getAnnouncements(),
  articles: await getArticles(),
  authors: await getAuthorEntries(),
  categories: await getCategories(),
  collection,
});
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
  structuredData={[
    breadcrumbListJsonLd(
      model.document.canonicalPath,
      model.breadcrumbs,
      Astro.site,
    ),
    itemListJsonLd(model.document.canonicalPath, model.items, Astro.site),
  ]}
>
  <BrowsingBody>
    <ArchiveListBlock
      eyebrow={model.eyebrow}
      title={model.title}
      description={model.description}
      items={model.items}
    />
  </BrowsingBody>
</BaseLayout>
