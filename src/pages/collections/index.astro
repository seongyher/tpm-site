---
import TermOverviewBlock from "../../components/blocks/terms/TermOverviewBlock.astro";
import BrowsingBody from "../../components/layout/BrowsingBody.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEditorialCollections } from "../../lib/content/content";
import { collectionsIndexRouteViewModel } from "../../lib/content/listing-route-view-models";
import { itemListJsonLd } from "../../lib/metadata/metadata";

const model = collectionsIndexRouteViewModel(await getEditorialCollections());
---

<BaseLayout
  title={model.document.title}
  description={model.document.description}
  canonicalPath={model.document.canonicalPath}
  kind={model.document.kind}
  structuredData={[
    itemListJsonLd(model.document.canonicalPath, model.items, Astro.site),
  ]}
>
  <BrowsingBody>
    <TermOverviewBlock
      title={model.overviewTitle}
      description={model.overviewDescription}
      items={model.items}
      itemNoun={model.itemNoun}
      itemNounPlural={model.itemNounPlural}
      emptyLabel={model.emptyLabel}
    />
  </BrowsingBody>
</BaseLayout>
